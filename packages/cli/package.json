{
  "name": "@wzrdtech/zap",
  "version": "5.0.0",
  "private": false,
  "description": "Agent-first CLI for creating, validating, and running Zap recipes.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "zap": "bin/zap.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gratitude5dee/Zap.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/gratitude5dee/Zap/issues"
  },
  "homepage": "https://zap.wzrd.tech",
  "files": [
    "bin",
    "resources",
    "src",
    "README.md",
    "v5"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@wzrdtech/core": "5.0.0",
    "@wzrdtech/zap-mcp": "5.0.0",
    "@wzrdtech/providers": "5.0.0",
    "convex": "^1.28.0",
    "yaml": "^2.8.1",
    "@wzrdtech/zap-agent": "5.0.0",
    "@wzrdtech/zap-kernel": "5.0.0",
    "@wzrdtech/zap-runtime": "5.0.0"
  },
  "engines": {
    "node": "24.x"
  },
  "exports": {
    ".": "./src/cli.js",
    "./sandbox/*": {
      "types": "./v5/sandbox/*.d.ts",
      "import": "./v5/sandbox/*.js"
    },
    "./memory/*": {
      "types": "./v5/memory/*.d.ts",
      "import": "./v5/memory/*.js"
    },
    "./harness/*": {
      "types": "./v5/harness/*.d.ts",
      "import": "./v5/harness/*.js"
    },
    "./pay/*": {
      "types": "./v5/pay/*.d.ts",
      "import": "./v5/pay/*.js"
    },
    "./package.json": "./package.json"
  }
}
