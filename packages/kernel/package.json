{
  "name": "@wzrdtech/zap-kernel",
  "version": "5.0.0",
  "private": false,
  "description": "Zap kernel: composable plugin contexts with reversible effects, services, events, and loader reconciliation.",
  "license": "MIT",
  "type": "module",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/rewrite-dts-imports.mjs dist",
    "prepack": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gratitude5dee/Zap.git",
    "directory": "packages/kernel"
  },
  "bugs": {
    "url": "https://github.com/gratitude5dee/Zap/issues"
  },
  "homepage": "https://zap.wzrd.tech",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "engines": {
    "node": "24.x"
  }
}
