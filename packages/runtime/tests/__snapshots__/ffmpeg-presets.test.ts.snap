// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`ffmpeg presets > every preset dry-runs to a stable argv fixture 1`] = `
{
  "extract-audio": [
    "ffmpeg",
    "-hide_banner",
    "-y",
    "-i",
    "in-0.mp4",
    "-i",
    "in-1.mp4",
    "-vn",
    "-c:a",
    "libmp3lame",
    "-q:a",
    "2",
    "out.bin",
  ],
  "gen-media-post": [
    "ffmpeg",
    "-hide_banner",
    "-y",
    "-i",
    "in-0.mp4",
    "-i",
    "in-1.mp4",
    "-movflags",
    "+faststart",
    "-pix_fmt",
    "yuv420p",
    "-c:v",
    "libx264",
    "-crf",
    "20",
    "-c:a",
    "aac",
    "out.bin",
  ],
  "overlay": [
    "ffmpeg",
    "-hide_banner",
    "-y",
    "-i",
    "in-0.mp4",
    "-i",
    "in-1.mp4",
    "-filter_complex",
    "overlay=0:0",
    "out.bin",
  ],
  "scale-720p": [
    "ffmpeg",
    "-hide_banner",
    "-y",
    "-i",
    "in-0.mp4",
    "-i",
    "in-1.mp4",
    "-vf",
    "scale=-2:720",
    "-c:v",
    "libx264",
    "-crf",
    "23",
    "-c:a",
    "copy",
    "out.bin",
  ],
  "stitch": [
    "ffmpeg",
    "-hide_banner",
    "-y",
    "-i",
    "in-0.mp4",
    "-i",
    "in-1.mp4",
    "-filter_complex",
    "[0:v][0:a][1:v][1:a]concat=n=2:v=1:a=1[v][a]",
    "-map",
    "[v]",
    "-map",
    "[a]",
    "out.bin",
  ],
  "thumbnail": [
    "ffmpeg",
    "-hide_banner",
    "-y",
    "-i",
    "in-0.mp4",
    "-i",
    "in-1.mp4",
    "-ss",
    "0",
    "-frames:v",
    "1",
    "out.bin",
  ],
  "transcode-h264": [
    "ffmpeg",
    "-hide_banner",
    "-y",
    "-i",
    "in-0.mp4",
    "-i",
    "in-1.mp4",
    "-c:v",
    "libx264",
    "-preset",
    "medium",
    "-crf",
    "23",
    "-c:a",
    "aac",
    "out.bin",
  ],
  "trim": [
    "ffmpeg",
    "-hide_banner",
    "-y",
    "-i",
    "in-0.mp4",
    "-i",
    "in-1.mp4",
    "-ss",
    "0",
    "-t",
    "1",
    "-c",
    "copy",
    "out.bin",
  ],
}
`;
