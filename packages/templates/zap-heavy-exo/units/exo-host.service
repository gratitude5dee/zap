[Unit]
Description=exo host: re-register the --private route for 8642
# Open ports are not captured by snapshots; hosted URLs and tokens are sticky
# but the route binds the machine's current address, so re-run host on every
# boot and resume.
After=exo-agentd.service
Wants=exo-agentd.service

[Service]
Type=oneshot
# agentd is a plain Type=simple unit, so After= only orders on spawn; wait
# for 8642 to listen before registering the route.
ExecStart=/bin/bash -c 'for i in $(seq 1 30); do /usr/local/bin/host 8642 --private && exit 0; sleep 2; done; exit 1'
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
