{
  "name": "zap-heavy-hermes",
  "weight": "heavy",
  "from": "zap-heavy",
  "description": "zap-heavy with the Hermes harness: api_server on 0.0.0.0:8642 behind a per-box API_SERVER_KEY and a --private hosted route, dashboard on 9119, filesystem memory on, OpenViking MCP registered.",
  "channel": "ship",
  "namedSnapshot": true,
  "harness": "hermes",
  "units": [
    "zap-agentd.service",
    "hermes-gateway.service",
    "hermes-dashboard.service",
    "hermes-host.service"
  ],
  "ports": [
    {
      "port": 8642,
      "role": "api",
      "hostPrivate": true
    },
    {
      "port": 9119,
      "role": "dashboard",
      "hostPrivate": true
    }
  ],
  "stateDirs": [
    "~/.hermes"
  ],
  "mcpConfig": {
    "path": "~/.hermes/config.yaml",
    "format": "yaml"
  },
  "pins": {
    "tailscale": "1.82.0",
    "cotal": "0.33.1",
    "sam": "v0.1.0-alpha.7",
    "mesh-llm": "v0.75.1",
    "taskrouter-model": "qwen2.5-1.5b-instruct-q4_k_m"
  },
  "connectivity": {
    "tailscale": false,
    "cotal": false,
    "taskrouter": false,
    "samMesh": false,
    "x402": false
  }
}
