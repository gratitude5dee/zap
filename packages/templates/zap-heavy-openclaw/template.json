{
  "name": "zap-heavy-openclaw",
  "weight": "heavy",
  "from": "zap-heavy",
  "description": "zap-heavy with the OpenClaw harness: gateway on 18789 (lan bind, per-box auth token, chat-completions endpoint on, channels off) behind a --private hosted route.",
  "channel": "ship",
  "namedSnapshot": true,
  "harness": "openclaw",
  "units": [
    "zap-agentd.service",
    "openclaw-gateway.service"
  ],
  "ports": [
    {
      "port": 18789,
      "role": "api",
      "hostPrivate": true
    }
  ],
  "stateDirs": [
    "~/.openclaw"
  ],
  "mcpConfig": {
    "path": "~/.openclaw/openclaw.json",
    "format": "json5"
  },
  "pins": {
    "tailscale": "1.82.0",
    "cotal": "0.33.1",
    "sam": "v0.1.0-alpha.7",
    "mesh-llm": "v0.75.1",
    "taskrouter-model": "qwen2.5-1.5b-instruct-q4_k_m"
  },
  "connectivity": {
    "tailscale": false,
    "cotal": false,
    "taskrouter": false,
    "samMesh": false,
    "x402": false
  }
}
