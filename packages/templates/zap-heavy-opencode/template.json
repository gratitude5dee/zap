{
  "name": "zap-heavy-opencode",
  "weight": "heavy",
  "from": "zap-heavy",
  "description": "zap-heavy with the OpenCode harness: `opencode serve` on 0.0.0.0:4096 behind a per-box OPENCODE_SERVER_PASSWORD and a --private hosted route.",
  "channel": "ship",
  "namedSnapshot": true,
  "harness": "opencode",
  "units": [
    "zap-agentd.service",
    "opencode-serve.service"
  ],
  "ports": [
    {
      "port": 4096,
      "role": "api",
      "hostPrivate": true
    }
  ],
  "stateDirs": [
    "~/.config/opencode"
  ],
  "mcpConfig": {
    "path": "~/.config/opencode/opencode.json",
    "format": "json"
  },
  "pins": {
    "tailscale": "1.82.0",
    "cotal": "0.33.1",
    "sam": "v0.1.0-alpha.7",
    "mesh-llm": "v0.75.1",
    "taskrouter-model": "qwen2.5-1.5b-instruct-q4_k_m"
  },
  "connectivity": {
    "tailscale": false,
    "cotal": false,
    "taskrouter": false,
    "samMesh": false,
    "x402": false
  }
}
