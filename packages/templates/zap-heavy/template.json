  "presetsManifest": "/zap/ffmpeg-presets.json",
  "pins": {
    "tailscale": "1.82.0",
    "cotal": "0.33.1",
    "sam": "v0.1.0-alpha.7",
    "mesh-llm": "v0.75.1",
