{
  "name": "zap-heavy",
  "weight": "heavy",
  "from": "zap-med",
  "description": "zap-med plus on-VM memory (OpenViking), the API store (open-connector, loopback), and the skills store. Base for every zap-heavy-<harness> template.",
  "channel": "ship",
  "namedSnapshot": true,
  "units": [
    "zap-agentd.service",
    "zap-openviking.service",
    "zap-open-connector.service",
    "zap-host.service"
